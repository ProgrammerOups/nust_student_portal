generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  studentId    String   @unique
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  program      String
  currentGPA   Float    @default(0.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}